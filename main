#!/usr/bin/env python3

import argparse
import json
from pathlib import Path
import sys

from src.graph import load_test_case
from src.interprocedural import analyse_interprocedural


def main() -> int:
    parser = argparse.ArgumentParser(description="Analyse static source-to-sink taint flow.")
    parser.add_argument("-i", required=True, type=Path, metavar="DIRECTORY")
    args = parser.parse_args()

    try:
        if not args.i.is_dir():
            raise ValueError(f"Input directory does not exist or is not a directory: {args.i}")
        graph, metadata = load_test_case(args.i)
        result = analyse_interprocedural(graph, metadata)
    except (OSError, ValueError, KeyError, NotImplementedError) as error:
        print(f"main: {error}", file=sys.stderr)
        return 1

    print(json.dumps({"reaches": result}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
